# Teluginti Mithai — Supabase connection
# 1. Supabase Dashboard → Project Settings → API
# 2. Copy these two values below
# 3. Save this file as .env.local (same folder as package.json) and rebuild
#
# Without these keys the site runs in local-demo mode (browser storage).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
